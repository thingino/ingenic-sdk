MODULE_NAME := mpsys_driver
OUT := $(MODULE_NAME)

DIR=$(KERNEL_VERSION)/misc/mpsys-driver

# T33 (PRJ008) has its own mpsys sources and firmware blob
ifeq ($(SOC_FAMILY),t33)
DIR := $(DIR)/t33
endif

SRCS := $(DIR)/mpsys_module.c \
	$(DIR)/private-funcs.c

# Determine the kernel version based on SOC type and KDIR
ifeq ($(SOC_FAMILY),t41)
	ifneq ($(findstring 4.4,$(KERNEL_VERSION)),)
		KVERSION := 4-4-94
	else
		KVERSION := 3-10-14
	endif
else ifeq ($(SOC_FAMILY),t40)
	KVERSION := 4-4-94
endif

OBJS := $(SRCS:%.c=%.o) $(ASM_SRCS:%.S=%.o)
ifeq ($(SOC_FAMILY),t33)
OBJS += $(DIR)/PRJ008-mpsys-firmware-4-4-94.a
else
OBJS += $(DIR)/$(SOC_FAMILY)-libmpsys-firmware-$(KVERSION).a
endif

$(OUT)-objs := $(OBJS)

obj-m += $(OUT).o
