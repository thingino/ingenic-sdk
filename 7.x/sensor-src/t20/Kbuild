# T10 and T20 sensors, built against isp/t20
SENSORS := jxf23 jxh42 ov9712
SOCU := $(shell echo $(SOC_FAMILY) | tr a-z A-Z)
ccflags-y += -I$(src)/../../isp/t20/include -I$(src)/../../isp/t20/compat -I$(src)/../../isp/t20 -DCONFIG_SOC_$(SOCU) -Wno-error
include $(src)/../sensors.mk
