# ipu-<soc>.ko, soc = t32, t32pro or t33: /dev/ipu (libimp OSD) with the IPU v13,
# vendor SDK 2.0.0 kernel 5.15.170 drivers/video/ingenic_ipu
prj := $(if $(filter t33,$(SOC_FAMILY)),PRJ008,$(if $(filter t32pro,$(SOC_FAMILY)),PRJ009,PRJ007))
ccflags-y += -I$(src) -I$(src)/../../rmem -DCONFIG_SOC_$(prj) -Wno-error

ipu-$(SOC_FAMILY)-objs := ingenic_ipu_v13.o
obj-m += ipu-$(SOC_FAMILY).o
