# SPDX-License-Identifier: GPL-2.0
# tx-isp-t40.ko: the 4.4.94-built T40 ISP firmware (libt40-firmware.a, 1.3.1) plus the adapter
# that lets it run on Linux 7.x.

ccflags-y += -I$(src)/include -I$(src)
ccflags-y += -DCONFIG_KERNEL_4_4_94 -Wno-unused-function

# the vendor toolchain sets an e_flags bit the mainline one does not know
ldflags-y += --no-warn-mismatch

tx-isp-t40-objs := tx-isp-module.o tx-isp-funcs.o tx-isp-abi.o txx-funcs.o \
		   tx-isp-sinfo.o tx-isp-exports.o tx-isp-twin.o tx-isp-fw.o

obj-m += tx-isp-t40.o

T40_FW := sdk/libt40-firmware.fw

# The firmware's direct imports whose semantics or layout changed on 7.x are
# redirected to the translators in txx-funcs.c, tx-isp-abi.c and
# tx-isp-twin.c. printk is a macro now; __copy_user is the same routine as
# 7.x's __raw_copy_to_user.
T40_REDEF := \
	--redefine-sym printk=_printk \
	--redefine-sym PDE_DATA=t40_pde_data_44 \
	--redefine-sym seq_printf=t40_seq_printf_44 \
	--redefine-sym schedule_timeout=t40_schedule_timeout_44 \
	--redefine-sym cdev_init=t40_cdev_init_44 \
	--redefine-sym cdev_del=t40_cdev_del_44 \
	--redefine-sym clk_get=t40_clk_get_44 \
	--redefine-sym clk_set_parent=t40_clk_set_parent_44 \
	--redefine-sym queue_work_on=t40_queue_work_on_44 \
	--redefine-sym flush_workqueue=__flush_workqueue \
	--redefine-sym kmalloc_caches=t40_kmalloc_caches \
	--redefine-sym kmem_cache_alloc=t40_kmem_cache_alloc_44 \
	--redefine-sym __class_create=t40_class_create_44 \
	--redefine-sym class_destroy=t40_class_destroy_44 \
	--redefine-sym device_destroy=t40_device_destroy_44 \
	--redefine-sym mips_dma_map_ops=t40_dma_map_ops \
	--redefine-sym __ioremap=t40___ioremap_44 \
	--redefine-sym __iounmap=iounmap \
	--redefine-sym __copy_user=__raw_copy_to_user \
	--redefine-sym __div64_32=t40___div64_32 \
	--redefine-sym mips_io_port_base=t40_mips_io_port_base

# 4.4.94's 8-byte __ksymtab entries and their strings: tx-isp-exports.c
# exports the same the firmware's ksymtab symbols in the native format.
T40_STRIP := -R '___ksymtab+*' -R '.rel___ksymtab+*' -R __ksymtab_strings \
	     -R '__ksymtab*' -R '.rel__ksymtab*'

# The firmware's remove callbacks sit in .exit.text but are referenced from
# its .data, which modpost rejects; as plain text they are never discarded.
T40_REDEF += --rename-section .exit.text=.text.t40_exit \
	     --rename-section .rel.exit.text=.rel.text.t40_exit

quiet_cmd_t40fw = FWFIX   $@
      cmd_t40fw = $(OBJCOPY) $(T40_REDEF) $(T40_STRIP) $< $@

$(obj)/tx-isp-fw.o: $(src)/$(T40_FW) FORCE
	$(call if_changed,t40fw)

targets += tx-isp-fw.o
