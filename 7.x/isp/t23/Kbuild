# SPDX-License-Identifier: GPL-2.0
# tx-isp-t23.ko: the 4.4.94-built T23 ISP firmware (libt23-firmware-540-4494.a,
# 1.3.0) plus the adapter that lets it run on Linux 7.x.
#
# CONFIG_MULTI_SENSOR=1 builds it from the firmware's multi-sensor build
# instead (1.3.0-double, up to three sensors behind a MIPI switch); the
# sensor drivers then have to be built with the same flag.

ccflags-y += -I$(src)/include -I$(src)
ccflags-y += -Wno-unused-function

tx-isp-t23-objs := tx-isp-module.o tx-isp-debug.o tx-isp-abi.o txx-funcs.o \
		   tx-isp-sinfo.o tx-isp-exports.o tx-isp-twin.o tx-isp-fw.o \
		   tx-isp-fwc.o

obj-m += tx-isp-t23.o

ifdef CONFIG_MULTI_SENSOR
ccflags-y += -DCONFIG_MULTI_SENSOR
tx-isp-t23-objs += tx-isp-fwc-tun-ms.o
T23_FW := sdk/libt23-firmware-double.fw
else
tx-isp-t23-objs += tx-isp-fwc-tun.o
T23_FW := sdk/libt23-firmware.fw
endif

# The firmware's direct imports whose semantics or layout changed on 7.x are
# redirected to the translators in txx-funcs.c and tx-isp-twin.c. printk is a
# macro now; __copy_user is the same routine as 7.x's __raw_copy_to_user.
T23_REDEF := \
	--redefine-sym printk=_printk \
	--redefine-sym __platform_driver_register=t23_platform_driver_register_44 \
	--redefine-sym __class_create=t23_class_create_310 \
	--redefine-sym kmalloc_caches=t23_kmalloc_caches \
	--redefine-sym kmem_cache_alloc=t23_kmem_cache_alloc_310 \
	--redefine-sym PDE_DATA=t23_pde_data_310 \
	--redefine-sym preempt_schedule=t23_preempt_schedule_310 \
	--redefine-sym seq_printf=t23_seq_printf_310 \
	--redefine-sym schedule_timeout=t23_schedule_timeout_310 \
	--redefine-sym cdev_init=t23_cdev_init_310 \
	--redefine-sym cdev_del=t23_cdev_del_310 \
	--redefine-sym class_destroy=t23_class_destroy_310 \
	--redefine-sym device_destroy=t23_device_destroy_310 \
	--redefine-sym clk_get=t23_clk_get_44 \
	--redefine-sym clk_set_parent=t23_clk_set_parent_44 \
	--redefine-sym dma_cache_sync=t23_priv_dma_cache_sync \
	--redefine-sym warn_slowpath_null=t23_warn_slowpath_null_44 \
	--redefine-sym mips_dma_map_ops=t23_dma_map_ops \
	--redefine-sym dma_alloc_from_coherent=t23_dma_alloc_from_coherent_44 \
	--redefine-sym dma_release_from_coherent=t23_dma_release_from_coherent_44 \
	--redefine-sym __copy_user=__raw_copy_to_user \
	--redefine-sym getrawmonotonic64=ktime_get_raw_ts64 \
	--redefine-sym __div64_32=t23_div64_32_44 \
	--globalize-symbol=tevent_info

# tx-isp-fwc.c and tx-isp-fwc-tun.c (tx-isp-fwc-tun-ms.c for the multi-sensor
# firmware) take over the five firmware functions that read addr_limit through
# $gp, and the one that calls the biggest of them. The firmware's own copies
# are renamed t23fw_* and made global so the slot checks can name them; the
# firmware's local data, tables and helpers the C code uses are made global.
T23_FWC_FUNCS := tisp_vic_ctrl_ioctl video_input_cmd_set isp_tunning_read \
	tisp_code_tuning_ioctl isp_core_tunning_unlocked_ioctl
T23_FWC_SHARED := isp_vic_frd_fops video_input_cmd_fops isp_core_tunning_fops \
	st_vic_save_par vaddr video_input_cmd_buf tisp_par_ioctl \
	apical_isp_core_ops_s_ctrl
ifdef CONFIG_MULTI_SENSOR
T23_FWC_SHARED += apical_isp_mask_g_attr.isra.75 apical_isp_expr_g_ctrl.isra.79 \
	apical_isp_max_again_g_ctrl.isra.80 apical_isp_max_dgain_g_ctrl.isra.81 \
	apical_isp_ev_g_attr.isra.82 apical_isp_gamma_g_attr.isra.83 apical_isp_ae_g_roi.isra.84 \
	apical_isp_ae_zone_g_ctrl.isra.90 apical_isp_af_zone_g_ctrl.isra.91 \
	apical_isp_ae_zone_weight_g_attr.isra.95 apical_isp_ae_hist_origin_g_attr.isra.98 \
	apical_isp_awb_zone_statis_g_attr.isra.100 apical_isp_af_hist_g_attr.isra.101 \
	apical_isp_af_weight_g_attr.isra.102 tiziano_isp_ae_manual_attr_g_ctrl.isra.108 \
	tiziano_isp_csc_g_attr.isra.113
else
T23_FWC_SHARED += apical_isp_awb_zone_statis_g_attr.isra.97 apical_isp_awb_zone_weight_g_attr.isra.115 \
	apical_isp_ae_g_roi.isra.80 apical_isp_expr_g_ctrl.isra.75 apical_isp_ev_g_attr.isra.78 \
	apical_isp_ae_zone_weight_g_attr.isra.92 apical_isp_ae_zone_g_ctrl.isra.87 \
	apical_isp_ae_hist_origin_g_attr.isra.95 apical_isp_max_dgain_g_ctrl.isra.77 \
	apical_isp_max_again_g_ctrl.isra.76 apical_isp_gamma_g_attr.isra.79 \
	apical_isp_af_hist_g_attr.isra.98 tiziano_isp_ae_manual_attr_g_ctrl.isra.106 \
	apical_isp_af_weight_g_attr.isra.99 apical_isp_af_zone_g_ctrl.isra.88 \
	apical_isp_autozoom_g_attr.isra.71
endif
T23_REDEF += $(foreach f,$(T23_FWC_FUNCS),--redefine-sym $(f)=t23fw_$(f) --globalize-symbol=t23fw_$(f)) \
	     $(foreach f,$(T23_FWC_SHARED),--globalize-symbol=$(f))

# 4.4.94's 8-byte __ksymtab entries and their strings: tx-isp-exports.c
# exports the same 25 symbols in the native format.
T23_STRIP := -R '___ksymtab+*' -R '.rel___ksymtab+*' -R __ksymtab_strings \
	     -R '__ksymtab*' -R '.rel__ksymtab*'

# The firmware's remove callbacks sit in .exit.text but are referenced from
# its .data, which modpost rejects; as plain text they are never discarded.
T23_REDEF += --rename-section .exit.text=.text.t23_exit \
	     --rename-section .rel.exit.text=.rel.text.t23_exit

quiet_cmd_t23fw = FWFIX   $@
      cmd_t23fw = $(OBJCOPY) $(T23_REDEF) $(T23_STRIP) $< $@

$(obj)/tx-isp-fw.o: $(src)/$(T23_FW) FORCE
	$(call if_changed,t23fw)

targets += tx-isp-fw.o
