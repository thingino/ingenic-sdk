# SPDX-License-Identifier: GPL-2.0
# tx-isp-t21.ko: the 3.10-built T21 ISP firmware (libt21-firmware.a, 1.0.33)
# plus the adapter that lets it run on Linux 7.x.

ccflags-y += -I$(src)/include -I$(src)
ccflags-y += -Wno-unused-function

tx-isp-t21-objs := tx-isp-module.o tx-isp-debug.o tx-isp-abi.o txx-funcs.o \
		   tx-isp-sinfo.o tx-isp-exports.o tx-isp-fwc.o tx-isp-fwc-vfs.o tx-isp-fwc-txioctl.o tx-isp-fwc-fch.o tx-isp-fw.o

obj-m += tx-isp-t21.o

T21_FW := sdk/libt21-firmware.fw

# The firmware's direct imports whose semantics or layout changed on 7.x are
# redirected to the translators in txx-funcs.c. printk is a macro now.
T21_REDEF := \
	--redefine-sym printk=_printk \
	--redefine-sym vfs_read=private_vfs_read \
	--redefine-sym arch_local_irq_save=t21_irq_save_310 \
	--redefine-sym arch_local_irq_restore=t21_irq_restore_310 \
	--redefine-sym kfree_skb=t21_kfree_skb_310 \
	--redefine-sym __kmalloc=t21_kmalloc_310 \
	--redefine-sym dma_cache_sync=t21_dma_cache_sync_310 \
	--redefine-sym PDE_DATA=t21_pde_data_310 \
	--redefine-sym preempt_schedule=t21_preempt_schedule_310 \
	--redefine-sym seq_printf=t21_seq_printf_310 \
	--globalize-symbol=tevent_info

# tx-isp-fwc.c takes over the firmware code that reads kernel objects by
# 3.10 offset. Static functions are renamed t21fw_* and made global so the
# slot checks and the forwarding can name them; global ones are weakened;
# the firmware helpers and data the C code uses are made global.
T21_FWC_STATIC := tx_isp_open tx_isp_release frame_channel_open \
	frame_channel_release isp_core_tunning_open isp_core_tunning_release \
	isp_core_tunning_unlocked_ioctl tx_isp_unlocked_ioctl \
	frame_channel_unlocked_ioctl ispcore_pad_event_handle \
	isp_vic_cmd_set video_input_cmd_set
T21_FWC_WEAK := tisp_netlink_exit tiziano_load_parameters
T21_FWC_SHARED := tx_isp_fops fs_channel_ops isp_core_tunning_fops \
	isp_vic_frd_fops video_input_cmd_fops \
	apical_isp_core_ops_s_ctrl apical_isp_core_ops_g_ctrl \
	__frame_channel_vb2_streamoff __vb2_queue_free \
	tx_isp_video_link_destroy.isra.1 nlsk vic_cmd_buf video_input_cmd_buf \
	tx_isp_video_s_stream tx_isp_video_link_stream find_subdev_link_pad \
	subdev_video_destroy_link link1 \
	check_state __vb2_queue_cancel __enqueue_in_driver __fill_v4l2_buffer count.35161
T21_REDEF += $(foreach f,$(T21_FWC_STATIC),--redefine-sym $(f)=t21fw_$(f) --globalize-symbol=t21fw_$(f)) \
	     $(foreach f,$(T21_FWC_WEAK),--weaken-symbol=$(f)) \
	     $(foreach f,$(T21_FWC_SHARED),--globalize-symbol=$(f))

# 3.10's 8-byte __ksymtab entries and their strings: tx-isp-exports.c
# exports the same 25 symbols in the native format.
T21_STRIP := -R '___ksymtab+*' -R '.rel___ksymtab+*' -R __ksymtab_strings

# The firmware's remove callbacks sit in .exit.text but are referenced from
# its .data, which modpost rejects; as plain text they are never discarded.
T21_REDEF += --rename-section .exit.text=.text.t21_exit \
	     --rename-section .rel.exit.text=.rel.text.t21_exit

quiet_cmd_t21fw = FWFIX   $@
      cmd_t21fw = $(OBJCOPY) $(T21_REDEF) $(T21_STRIP) $< $@

$(obj)/tx-isp-fw.o: $(src)/$(T21_FW) FORCE
	$(call if_changed,t21fw)

targets += tx-isp-fw.o
