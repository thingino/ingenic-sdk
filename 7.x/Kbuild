# SPDX-License-Identifier: GPL-2.0
# Out-of-tree modules for mainline Linux 7.x on the T10, T20, T21, T23, T30,
# T31, T32, T32 Pro, T33, T40 and T41 (see README.md). Included from the top-level Kbuild when
# KERNEL_VERSION=7.x.
#
# Each component is a directory with its own Kbuild, descended into from this
# one M= pass, so modpost resolves the sensors against tx-isp and every
# component keeps its own include paths and flags.
#
# Component switches, overridable on the make command line:
#   CONFIG_INGENIC_ISP     tx-isp-<soc>.ko
#   CONFIG_INGENIC_SENSOR  sensor_<name>_<soc>.ko: SENSOR_MODEL (and
#                          SENSOR_1_MODEL / SENSOR_2_MODEL), else every
#                          sensor in sensor-src/<soc>
#   CONFIG_INGENIC_VPU     soc-vpu-<soc>.ko (helix/radix, not on t31)
#   CONFIG_INGENIC_AVPU    avpu.ko (t31 and t41 only)
#   CONFIG_INGENIC_IPU     ipu-<soc>.ko (ipu.ko on t31), libimp OSD
#   CONFIG_INGENIC_AUDIO   audio.ko, oss2 or oss3 (CONFIG_INGENIC_AUDIO_VARIANT)
#   CONFIG_INGENIC_HDMI_AUDIO  hdmi_audio.ko (a1 only), /dev/dsp_hdmi_audio
#   CONFIG_INGENIC_FB      fb.ko (a1 only)
#   CONFIG_INGENIC_VDEC    vdec.ko (a1 only)
#   CONFIG_INGENIC_VO      vo.ko (a1 only)
#   CONFIG_INGENIC_AIP     ingenic-aip.ko (a1 only)
#   CONFIG_INGENIC_SOC_NNA soc-nna.ko (t40, t41 and a1), /dev/soc-nna
#   CONFIG_INGENIC_RMEM    rmem.ko, /dev/rmem for libimp
#   CONFIG_INGENIC_LOGGER  android_logger.ko, /dev/log_* for libimp
#   CONFIG_INGENIC_ADC_AUX adc-aux.ko, the vendor /dev/*adc_aux_N on the
#                          kernel's SADC driver

soc := $(SOC_FAMILY)
ifeq ($(filter t10 t20 t21 t23 t30 t31 t32 t32pro t33 t40 t41 a1,$(soc)),)
    $(error ingenic-sdk 7.x: SOC_FAMILY=$(soc) is not supported (t10 t20 t21 t23 t30 t31 t32 t32pro t33 t40 t41 a1))
endif

# The T10 runs the T20 ISP, VPU and sensor sources, built under its own names.
src_soc := $(if $(filter t10,$(soc)),t20,$(soc))
is_t31  := $(if $(filter t31,$(soc)),y)
is_t32  := $(if $(filter t32,$(soc)),y)
is_t32pro := $(if $(filter t32pro,$(soc)),y)
is_t33  := $(if $(filter t33,$(soc)),y)
is_t40  := $(if $(filter t40,$(soc)),y)
is_t41  := $(if $(filter t41,$(soc)),y)
is_a1   := $(if $(filter a1,$(soc)),y)

CONFIG_INGENIC_ISP           ?= $(if $(is_a1),n,y)
CONFIG_INGENIC_SENSOR        ?= $(if $(is_a1),n,y)
CONFIG_INGENIC_VPU           ?= $(if $(is_t31)$(is_t40)$(is_t41),n,y)
CONFIG_INGENIC_AVPU          ?= $(if $(is_t31)$(is_t40)$(is_t41),y,n)
CONFIG_INGENIC_IPU           ?= $(if $(is_t40)$(is_t41),n,y)
CONFIG_INGENIC_AUDIO         ?= y
CONFIG_INGENIC_AUDIO_VARIANT ?= $(if $(filter t23 t31 t32 t32pro t33 t40 t41 a1,$(soc)),oss3,oss2)
CONFIG_INGENIC_HDMI_AUDIO    ?= $(if $(is_a1),y,n)
CONFIG_INGENIC_AIP           ?= $(if $(is_a1),y,n)
CONFIG_INGENIC_SOC_NNA       ?= $(if $(is_t40)$(is_t41)$(is_a1),y,n)
CONFIG_INGENIC_VO            ?= $(if $(is_a1),y,n)
CONFIG_INGENIC_VDEC          ?= $(if $(is_a1),y,n)
CONFIG_INGENIC_FB            ?= $(if $(is_a1),y,n)
CONFIG_INGENIC_RMEM          ?= y
CONFIG_INGENIC_LOGGER        ?= y
CONFIG_INGENIC_ADC_AUX       ?= $(if $(is_a1),n,$(if $(CONFIG_IIO),y,n))

$(info ingenic-sdk: soc=$(soc) kernel=7.x)

ifeq ($(CONFIG_INGENIC_ISP),y)
    obj-m += 7.x/isp/$(src_soc)/
endif

ifeq ($(CONFIG_INGENIC_SENSOR),y)
    obj-m += 7.x/sensor-src/$(src_soc)/
endif

ifeq ($(CONFIG_INGENIC_VPU),y)
    obj-m += 7.x/vpu/$(if $(is_t32pro)$(is_t33),t32,$(src_soc))/
endif

ifeq ($(CONFIG_INGENIC_AVPU),y)
    obj-m += 7.x/avpu/$(src_soc)/
endif

ifeq ($(CONFIG_INGENIC_IPU),y)
    obj-m += 7.x/ipu/$(if $(is_t32)$(is_t32pro)$(is_t33),t32/,$(if $(is_a1),a1/,))
endif

ifeq ($(CONFIG_INGENIC_AUDIO),y)
    ifeq ($(CONFIG_INGENIC_AUDIO_VARIANT),oss2)
        obj-m += 7.x/audio/oss2/
    else
        obj-m += 7.x/audio/oss3/$(soc)/
    endif
endif

ifeq ($(CONFIG_INGENIC_HDMI_AUDIO),y)
    obj-m += 7.x/audio/hdmi_audio/a1/
endif

ifeq ($(CONFIG_INGENIC_VDEC),y)
    obj-m += 7.x/vdec/a1/
endif

ifeq ($(CONFIG_INGENIC_FB),y)
    obj-m += 7.x/fb/a1/
endif

ifeq ($(CONFIG_INGENIC_VO),y)
    obj-m += 7.x/vo/a1/
endif

ifeq ($(CONFIG_INGENIC_AIP),y)
    obj-m += 7.x/aip/
endif

ifeq ($(CONFIG_INGENIC_SOC_NNA),y)
    obj-m += 7.x/soc-nna/
endif

ifeq ($(CONFIG_INGENIC_RMEM),y)
    obj-m += 7.x/rmem/
endif

ifeq ($(CONFIG_INGENIC_LOGGER),y)
    obj-m += 7.x/logger/
endif

ifeq ($(CONFIG_INGENIC_ADC_AUX),y)
    obj-m += 7.x/adc-aux/
endif
